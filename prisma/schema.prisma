// Ziventa Gaushala data model.
//
// Division of responsibility with Supabase:
//   Supabase Auth owns the `auth.users` table and everything to do with
//   credentials, phone OTP and magic links. Prisma never touches it.
//   Prisma owns the `public` schema below. The link between them is
//   Customer.id, which holds the same UUID as auth.users.id.
//
// That split matters: it means phone OTP works without us building an SMS
// pipeline, while our business data stays in normal, migratable tables.
//
// The connection URL lives in prisma7.config.ts, not here - Prisma 7 moved it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- accounts

/// One row per signed-in customer. `id` is the Supabase auth.users UUID, so
/// there is no second identity to keep in sync.
///
/// There is deliberately no role column. The admin dashboard belongs to one
/// owner, named in ADMIN_EMAILS - see src/lib/admin.ts. A role here would be
/// a second way in, and editing a row in the Supabase table editor would then
/// be enough to hand someone every customer's address.
model Customer {
  id        String   @id @db.Uuid
  email     String?  @unique
  phone     String?  @unique
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses  Address[]
  orders     Order[]
  membership Membership?
  reviews    Review[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label     String? // "Home", "Office"
  line1     String
  line2     String?
  city      String
  state     String
  postcode  String
  country   String  @default("IN")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------- catalogue

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  /// Matches the data-id already used by the landing page cart: ghee-250, dhoop...
  slug        String  @unique
  name        String
  description String?
  sizeLabel   String?
  /// What anyone pays. Integer paise; never store money as a float.
  ///
  /// This is the REGULAR price, not the member one, and that direction is
  /// deliberate: code that reads a price without thinking about membership
  /// then charges full price, which is a billing question. If this held the
  /// member price instead, the same slip would hand the discount to every
  /// guest - which is exactly the bug this column pair was added to fix.
  pricePaise  Int
  /// What a member with a paid deposit pays. Always at or below pricePaise,
  /// enforced by a CHECK constraint.
  memberPricePaise Int
  /// Read-only rupee views of the two prices, calculated by Postgres.
  /// @ignore keeps them out of the client so nothing can try to write them,
  /// while still telling Prisma the columns exist - without this, `migrate
  /// dev` would see them as drift and drop them.
  priceRupees       Decimal? @map("price_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"pricePaise\")::numeric / (100)::numeric)")) @ignore
  memberPriceRupees Decimal? @map("member_price_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"memberPricePaise\")::numeric / (100)::numeric)")) @ignore
  imagePath   String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  /// Null means "not tracked"; a number means decrement on paid order.
  stockCount  Int?
  /// At or below this, the product counts as low stock. Per product because a
  /// 1kg tin and a 250g jar do not run out at the same pace.
  lowStockThreshold Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([isActive, sortOrder])
  @@map("products")
}

// ---------------------------------------------------------------- membership

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  LEFT
}

enum DepositStatus {
  UNPAID
  PAID
  REFUNDED
}

/// The Gir Gold Club. The 250-family cap is enforced in the database by the
/// unique seatNumber plus a CHECK constraint added in a migration - not left
/// to application code that could be bypassed by a concurrent signup.
model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// 1..250. Unique, so two families can never hold the same seat.
  ///
  /// Null once a family leaves. Postgres allows any number of NULLs in a
  /// unique index, which is what lets the seat pass to the next family while
  /// the departed family's record stays exactly where it is. A membership
  /// with no seatNumber does not count towards the 250.
  seatNumber Int? @unique

  /// The seat they used to hold, kept when the seat is released.
  ///
  /// Their history should not evaporate because they left, and if they come
  /// back we can tell them which seat was theirs. Not unique: over years, one
  /// seat number may have been held by several families in turn.
  formerSeatNumber Int?

  status        MembershipStatus @default(PENDING)
  depositStatus DepositStatus    @default(UNPAID)
  /// Refundable founding deposit, default Rs 5,000.
  depositPaise  Int              @default(500000)
  /// Read-only rupee view, calculated by Postgres. See priceRupees on Product.
  depositRupees Decimal?         @map("deposit_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"depositPaise\")::numeric / (100)::numeric)")) @ignore

  /// The one-time link emailed when a seat is approved. Cleared the moment
  /// the deposit lands, so a forwarded email cannot be replayed to pay twice
  /// or to reopen a settled membership.
  depositToken     String?   @unique
  depositTokenAt   DateTime?
  depositPaidAt    DateTime?

  joinedOn DateTime?
  leftOn   DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("memberships")
}

/// Pre-registration from the landing page, captured before an account exists.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  /// Short reference the customer can quote, e.g. ZGC-260908-A7K2. Nullable
  /// only because rows existed before this column did; every new one gets one.
  reference String? @unique

  fullName  String
  email     String
  phone     String?
  city      String?
  message   String?
  source    String   @default("website")
  status    String   @default("new") // new | contacted | converted | declined
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}

// ---------------------------------------------------------------- the herd

model Cow {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique // Kamdhenu, Radha, Ganga, Nandini
  breed       String    @default("Gir")
  dateOfBirth DateTime?
  description String?
  imagePath   String?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthReports HealthReport[]

  @@map("cows")
}

/// The vet reports the membership page promises members. Kept per-cow and
/// dated so a member can see the history for the herd behind their ghee.
model HealthReport {
  id    String @id @default(uuid()) @db.Uuid
  cowId String @db.Uuid
  cow   Cow    @relation(fields: [cowId], references: [id], onDelete: Cascade)

  reportedOn DateTime
  vetName    String?
  weightKg   Decimal? @db.Decimal(5, 2)
  summary    String
  /// Members-only by default; flip to publish one publicly.
  isPublic   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([cowId, reportedOn])
  @@map("health_reports")
}

// ---------------------------------------------------------------- commerce

/// Where the ORDER is in fulfilment. Payment is tracked separately below.
///
/// These used to be one enum holding PAID and FAILED beside SHIPPED and
/// DELIVERED - two different questions in one field. A cash-on-delivery order
/// is DELIVERED and not yet PAID at the same moment, and one column could not
/// say both.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

/// Whether the MONEY has arrived. Independent of fulfilment.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique

  /// Null for guest checkout - the landing page allows buying without an account.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  addressId String?  @db.Uuid
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  /// Contact details are snapshotted so an order stays readable even if the
  /// customer later edits their profile or deletes their account.
  contactName  String
  contactEmail String
  contactPhone String

  shipLine1    String
  shipLine2    String?
  shipCity     String
  shipState    String
  shipPostcode String
  shipCountry  String  @default("IN")

  subtotalPaise Int
  shippingPaise Int @default(0)
  totalPaise    Int

  /// Read-only rupee views, calculated by Postgres from the paise columns
  /// above. See priceRupees on Product for why these are @ignore.
  subtotalRupees Decimal? @map("subtotal_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"subtotalPaise\")::numeric / (100)::numeric)")) @ignore
  deliveryRupees Decimal? @map("delivery_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"shippingPaise\")::numeric / (100)::numeric)")) @ignore
  totalRupees    Decimal? @map("total_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"totalPaise\")::numeric / (100)::numeric)")) @ignore

  /// All three default to zero, so every existing order is unchanged. The
  /// database enforces total = subtotal - discount + shipping + tax.
  discountPaise Int @default(0)
  taxPaise      Int @default(0)
  /// Money handed back. Never more than was charged.
  refundedPaise Int @default(0)

  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentProvider  String?
  paymentReference String?
  notes            String?

  /// Optional free text, recorded when an order is cancelled.
  cancelReason   String?
  courier        String?
  trackingNumber String?

  /// Stamped when the order ENTERS each state, so "how long from order to
  /// dispatch" can be answered later without an audit table.
  confirmedAt  DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  returnedAt   DateTime?

  /// When this order took units out of stock, and when it gave them back.
  ///
  /// Two timestamps rather than one boolean, for the same reason as the
  /// statuses above: "when" answers questions later that "whether" cannot.
  ///
  /// Both are null on every order placed before stock was reserved at all.
  /// That is the point - cancelling one of those must not hand back inventory
  /// it never took. stockReleasedAt also makes the release idempotent.
  stockReservedAt DateTime?
  stockReleasedAt DateTime?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status, placedAt])
  @@index([paymentStatus, placedAt])
  /// Every dashboard figure is filtered by date first.
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Restrict, not cascade: deleting a product must never rewrite order history.
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Name and price snapshotted at purchase time for the same reason.
  productName    String
  unitPricePaise Int
  quantity       Int

  /// Read-only rupee views, calculated by Postgres. lineTotalRupees is
  /// unitPricePaise * quantity, so it can never disagree with the line.
  unitPriceRupees Decimal? @map("unit_price_rupees") @db.Decimal(12, 2) @default(dbgenerated("((\"unitPricePaise\")::numeric / (100)::numeric)")) @ignore
  lineTotalRupees Decimal? @map("line_total_rupees") @db.Decimal(12, 2) @default(dbgenerated("(((\"unitPricePaise\" * quantity))::numeric / (100)::numeric)")) @ignore

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------- reviews

model Review {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  authorName  String
  city        String?
  rating      Int
  body        String
  /// Nothing appears on the site until it is explicitly published.
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isPublished, createdAt])
  @@map("reviews")
}

// ------------------------------------------------------------- mail limits

/// One row per sign-in email we send, used only to rate limit.
///
/// The endpoint that sends sign-in links will mail any address it is given -
/// that is what it is for. Without a limit it is also a way to send
/// Ziventa-branded email to strangers, at our mail server's expense and our
/// domain's reputation.
///
/// Kept in the database rather than in memory because serverless instances do
/// not share memory: an in-process counter limits one instance while the next
/// request starts a fresh one somewhere else.
model EmailThrottle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Lower-cased recipient.
  email String
  /// What was sent, so one kind of mail cannot exhaust another's allowance.
  kind  String @default("auth_link")

  sentAt DateTime @default(now())

  @@index([email, kind, sentAt])
  @@index([sentAt])
  @@map("email_throttle")
}

// ----------------------------------------------------------- visitor data

/// One row per page view, for the admin visitor charts.
///
/// First-party and deliberately thin. There is no IP address, no raw
/// user-agent, no fingerprint and no full referrer URL - only what the charts
/// need:
///
///   visitorId  a random id kept in the visitor's own browser. It identifies a
///              browser, not a person, and is gone when they clear storage.
///   sessionId  rotates after 30 minutes of inactivity, which is what makes
///              "visits" countable separately from "visitors".
///   device     mobile | tablet | desktop, derived server-side then discarded.
///   browser    a family name only.
///   referrerHost  the domain someone came from, never the path - a path can
///              carry search terms or tokens.
///
/// customerId is set only when someone is signed in, which is what lets the
/// dashboard separate registered visitors from anonymous ones.
model PageView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId    String   @db.Uuid
  sessionId    String   @db.Uuid
  customerId   String?  @db.Uuid
  path         String
  referrerHost String?
  device       String
  browser      String
  /// Major version only - 152, not "152.0.7977.130".
  ///
  /// Enough to answer "is anyone below what the site supports", which is the
  /// only question it exists for, without keeping a string specific enough to
  /// help identify one person alongside their city and referrer.
  ///
  /// Null where the user agent did not state one, and on every view recorded
  /// before this column existed - the version was never kept, so there is
  /// nothing to backfill from.
  browserVersion Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@map("page_views")
}
