# Copy to .env.local and fill in from your Supabase project (ziventa_db).
# .env.local is gitignored - never commit real values.
#
# Where to find each of these in the Supabase dashboard:
#
#   Project Settings > API
#     Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#     anon / public key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     service_role key   -> SUPABASE_SERVICE_ROLE_KEY
#
#   Project Settings > Database > Connection string
#     Transaction pooler (port 6543) -> DATABASE_URL
#     Direct connection  (port 5432) -> DIRECT_URL

# ---------------------------------------------------------------- Supabase

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe to expose. It ships in the browser bundle by design, and Row Level
# Security - not secrecy - is what protects your data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER expose this one. It bypasses Row Level Security entirely. Server-side
# only: no NEXT_PUBLIC_ prefix, never imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Prisma

# Runtime queries. Use the TRANSACTION POOLER string (port 6543). Serverless
# functions open a connection per instance and would exhaust a direct pool.
# Supabase requires pgbouncer=true here so Prisma disables prepared statements.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations only. Use the SESSION POOLER (same pooler host, port 5432).
#
# Do NOT use the "Direct connection" string (db.<ref>.supabase.co). That host
# has no IPv4 address, and Vercel is IPv4-only, so builds there fail with a
# connection timeout that looks like a password problem. The session pooler
# runs DDL fine and is reachable from everywhere.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- email

# Order and enquiry notifications, sent through Resend (resend.com).
# Leave blank and nothing breaks - messages are written to the log instead,
# and the site never claims it sent an email that it did not.
RESEND_API_KEY=

# Resend's shared sender works with no domain setup, but can ONLY deliver to
# the email address that owns the Resend account - fine for testing.
# Once you verify a domain in Resend, change this to your own address.
MAIL_FROM=Ziventa Gaushala <onboarding@resend.dev>

# Where new orders and membership enquiries are sent.
MAIL_TO=dewikbavishi4@gmail.com

# ---------------------------------------------------------------- app

NEXT_PUBLIC_SITE_URL=http://localhost:3000
