# Copy to .env.local and fill in from your Supabase project (ziventa_db).
# .env.local is gitignored - never commit real values.
#
# Where to find each of these in the Supabase dashboard:
#
#   Project Settings > API
#     Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#     anon / public key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     service_role key   -> SUPABASE_SERVICE_ROLE_KEY
#
#   Project Settings > Database > Connection string
#     Transaction pooler (port 6543) -> DATABASE_URL
#     Direct connection  (port 5432) -> DIRECT_URL

# ---------------------------------------------------------------- Supabase

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Safe to expose. It ships in the browser bundle by design, and Row Level
# Security - not secrecy - is what protects your data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER expose this one. It bypasses Row Level Security entirely. Server-side
# only: no NEXT_PUBLIC_ prefix, never imported into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Prisma

# Runtime queries. Use the TRANSACTION POOLER string (port 6543). Serverless
# functions open a connection per instance and would exhaust a direct pool.
# Supabase requires pgbouncer=true here so Prisma disables prepared statements.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations only. Use the SESSION POOLER (same pooler host, port 5432).
#
# Do NOT use the "Direct connection" string (db.<ref>.supabase.co). That host
# has no IPv4 address, and Vercel is IPv4-only, so builds there fail with a
# connection timeout that looks like a password problem. The session pooler
# runs DDL fine and is reachable from everywhere.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- admin

# The ONE person who can open the admin dashboard at /admin - the shop owner.
#
# Must hold exactly one email address, matched against the signed-in account,
# which must also have a verified email. There is no admin role and no way to
# grant access from inside the app; this variable is the only door.
#
# Fails closed in every doubtful case:
#   blank or missing   -> nobody can get in
#   two or more emails -> nobody can get in (and an error is logged)
#
# Both are deliberate. Defaulting to "allow" would publish every customer's
# name, phone and address the moment this went missing on a deploy.
ADMIN_EMAILS=owner@example.com

# ---------------------------------------------------------------- email
#
# Sent with Nodemailer over SMTP. Nodemailer is a client, not a mail service -
# it needs a mail server to hand messages to. Any SMTP server works; nothing in
# the code names a provider.
#
# Leave these blank and nothing breaks: messages are written to the log
# instead, and the site never claims it sent an email that it did not.
#
# Test the settings before trusting them to customers:
#
#   npm run email:test -- you@example.com
#
# Hostinger (free with the hosting you already own; create the mailbox first
# under Emails in hPanel, then use its full address and password):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#
# Gmail (needs an App Password, not your normal one; 2-Step Verification must
# be on, and there is a 500/day cap):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#
# Resend over SMTP (user is the literal word "resend", pass is the API key):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Leave blank to decide from the port: 465 means implicit TLS, anything else
# starts in the clear and upgrades with STARTTLS. Only set this if your
# provider documents something unusual.
SMTP_SECURE=

# Who the mail appears to come from. Most servers refuse to send as an address
# that is not yours, so this normally has to match SMTP_USER or be an alias on
# the same domain.
MAIL_FROM=Ziventa Gaushala <orders@girbyziventa.com>

# Where new orders and membership enquiries are sent.
MAIL_TO=dewikbavishi4@gmail.com

# ---------------------------------------------------------------- app

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mobile sign-in. Leave false until an SMS provider is configured in Supabase
# (Authentication > Providers > Phone).
#
# Supabase does not send SMS itself - it hands the message to a provider you
# pay for, such as Twilio or MSG91. In India that provider also needs DLT
# registration with TRAI before a single message is delivered, which is
# paperwork rather than code.
#
# While this is false the Phone tab says so instead of letting someone type
# their number and watch it fail.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
